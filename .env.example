# Токен бота от @BotFather
BOT_TOKEN=
# Данные приложения с https://my.telegram.org (общие для всех сессий)
API_ID=
API_HASH=
# Telegram ID админов через запятую
ADMIN_IDS=
# Контакт поддержки (username без @)
SUPPORT_USERNAME=

# Папка данных: база, сессии аккаунтов, эмодзи. Должна сохраняться при перезапуске.
DATA_DIR=data

# Лимит успешных инвайтов на один аккаунт в сутки
DAILY_INVITE_LIMIT=40
# Сколько задач выполняется одновременно
MAX_CONCURRENT_TASKS=3
# Максимум юзеров в одном файле
MAX_TARGETS_PER_TASK=500

# Паузы (секунды)
CONTACT_SYNC_PAUSE_MIN=5
CONTACT_SYNC_PAUSE_MAX=12
USER_PAUSE_MIN=35
USER_PAUSE_MAX=65

